{
    "manifest_version":  3,
    "name":  "The Anchor Tab",
    "version":  "2.0.0",
    "description":  "A calm, personal new tab that keeps you on your top priorities: focus timer, 3 moves, backlog and Ethiopian date.",
    "chrome_url_overrides":  {
                                 "newtab":  "newtab.html"
                             },
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "permissions":  [
                        "storage",
                        "unlimitedStorage",
                        "notifications",
                        "alarms",
                        "identity",
                        "bookmarks",
                        "favicon",
                        "contextMenus",
                        "activeTab"
                    ],
    "host_permissions":  [
                             "http://127.0.0.1/*",
                             "http://localhost/*",
                             "https://www.googleapis.com/*",
                             "https://oauth2.googleapis.com/*"
                         ],
    "action":  {
                   "default_title":  "Open The Anchor Tab"
               },
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "key":  ""
}
